---
// A small original koala that peeks over the bottom edge. Decorative: the page works without it.
---
<div class="koala" aria-live="polite">
  <p class="koala-bubble" role="status" hidden></p>
  <button type="button" data-koala aria-label="Poke the koala">
    <svg class="koala-art" viewBox="0 0 120 104" width="96" height="83" aria-hidden="true" focusable="false">
      <g class="ear ear-l"><circle cx="22" cy="34" r="17" fill="#8d949b" /><circle cx="22" cy="34" r="9" fill="#f3c9cf" /></g>
      <g class="ear ear-r"><circle cx="98" cy="34" r="17" fill="#8d949b" /><circle cx="98" cy="34" r="9" fill="#f3c9cf" /></g>
      <ellipse cx="60" cy="104" rx="40" ry="28" fill="#9aa0a6" />
      <ellipse cx="60" cy="56" rx="39" ry="35" fill="#a8aeb4" />
      <ellipse cx="60" cy="72" rx="20" ry="13" fill="#c9cdd1" />
      <g class="eye" style="transform-origin: 44px 52px"><circle cx="44" cy="52" r="7.5" fill="#fff" /><circle class="pupil" cx="44" cy="52" r="3.6" fill="#1c1c1a" /></g>
      <g class="eye" style="transform-origin: 76px 52px"><circle cx="76" cy="52" r="7.5" fill="#fff" /><circle class="pupil" cx="76" cy="52" r="3.6" fill="#1c1c1a" /></g>
      <ellipse cx="60" cy="65" rx="10" ry="7" fill="#33332f" />
      <path d="M52 76 q8 6 16 0" fill="none" stroke="#6b6b66" stroke-width="2" stroke-linecap="round" />
      <ellipse class="paw" cx="30" cy="100" rx="11" ry="8" fill="#8d949b" />
      <ellipse class="paw" cx="90" cy="100" rx="11" ry="8" fill="#8d949b" />
    </svg>
    <span class="zzz" aria-hidden="true">z z z</span>
  </button>
</div>
<script>
  const root = document.querySelector('.koala');
  const btn = root.querySelector('[data-koala]');
  const bubble = root.querySelector('.koala-bubble');
  const pupils = [...root.querySelectorAll('.pupil')];
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lines = [
    "G'day! I'm the portfolio koala.",
    'Psst… the WildLens demo is worth a click.',
    'Quan measures everything. Even my naps.',
    'I run on eucalyptus and low p95 latency.',
    'Terraform destroy? Not on my watch.',
  ];
  let n = 0;
  let timer;

  if (!calm) {
    let frame;
    addEventListener('mousemove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = btn.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 3);
        const d = Math.hypot(dx, dy) || 1;
        const k = Math.min(3, d / 40) / d;
        pupils.forEach((p) => (p.style.transform = `translate(${dx * k}px, ${dy * k}px)`));
      });
    });
    setInterval(() => {
      if (root.classList.contains('asleep')) return;
      root.classList.add('wiggle');
      setTimeout(() => root.classList.remove('wiggle'), 700);
    }, 9000);
  }

  btn.addEventListener('click', () => {
    const wasAsleep = root.classList.contains('asleep');
    root.classList.remove('asleep');
    bubble.textContent = wasAsleep ? 'Zzz… oh! ' + lines[0] : lines[n++ % lines.length];
    bubble.hidden = false;
    if (!calm) {
      root.classList.remove('hop');
      void root.offsetWidth;
      root.classList.add('hop');
    }
    clearTimeout(timer);
    timer = setTimeout(() => (bubble.hidden = true), 3200);
  });

  const contact = document.getElementById('contact');
  if (contact && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      root.classList.toggle('asleep', entry.isIntersecting);
      if (entry.isIntersecting) bubble.hidden = true;
    }, { threshold: 0.6 }).observe(contact);
  }
</script>
